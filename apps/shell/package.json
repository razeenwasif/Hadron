{
  "name": "@flux/shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.hud.config.ts",
    "preview:ui": "vite build --config vite.preview.config.ts && vite preview --config vite.preview.config.ts --port 8847",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@paper-design/shaders": "0.0.82",
    "@picovoice/porcupine-web": "^4.0.0",
    "@tauri-apps/api": "^2.5.0",
    "katex": "^0.16.47",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "typescript": "^5.7.0",
    "vite": "^6.4.6",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.1.11"
  }
}
